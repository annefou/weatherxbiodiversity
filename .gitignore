# Data (large files — download via pipeline)
data/
!data/.gitkeep

# Results (large files)
results/*.pth
results/logs/
!results/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Jupyter notebooks generated from Jupytext
notebooks/*.ipynb

# Environment
.env
*.egg-info/

# Soroye Figshare dataset (reference data, ~11 GB uncompressed) — too big
reference/Bumblebee_repo.zip
reference/Bumblebee_repo_wbombusdat/

# Python port intermediate artefacts (regenerated by pipeline)
soroye_port/outputs/*.npz
soroye_port/outputs/*.parquet
soroye_port/outputs/bombus_clean.csv
soroye_port/outputs_iberia/*.npz
soroye_port/outputs_iberia/*.parquet
soroye_port/outputs_iberia/bombus_clean.csv

# Snakemake run state
.snakemake/

# MyST build output
_build/

# Local copy of paywalled reference paper
science.aax8591.pdf

# Credentials: copy credentials/*.example.json to credentials/*.json and fill in
credentials/*.json
!credentials/*.example.json

# Marker written by the workflow after extracting the Figshare tables
reference/.figshare_*

# Workflow re-runs (compared against the committed published results)
soroye_port/run/
